{
  "name": "my-universe",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "scenarios": "node scripts/scenarios.ts",
    "validate": "node scripts/scenarios.ts validate",
    "simulate": "node scripts/simulate.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:browser": "playwright test",
    "benchmark": "node scripts/benchmark.ts",
    "audit": "node scripts/audit.ts",
    "benchmark:gravity": "node scripts/gravity-benchmark.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
